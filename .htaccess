# Stradaworks — plain PHP site

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Strip a trailing slash from page URLs (/about/ -> /about)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Clean URLs: /about -> about.php, but never rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]
</IfModule>

ErrorDocument 404 /404.php

# The includes directory is never requested directly
<IfModule mod_authz_core.c>
  <FilesMatch "^(config|header|footer|scripts)\.php$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
